# Copy this file to .env for local testing. In GitHub Actions, these are set as
# Repository Secrets instead (Settings -> Secrets and variables -> Actions).

# --- Content generation ---
# Preferred: OpenAI. If this key is missing or the API call fails,
# the pipeline falls back to Anthropic (Claude) automatically.
OPENAI_API_KEY=
# Fallback when OpenAI is unavailable
ANTHROPIC_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Quote card look: dark | light | alternate (default alternate by date)
# QUOTE_TEMPLATE=alternate
# Fail local builds if assets/audio has no track (CI already requires audio)
# REQUIRE_AUDIO=true
# Allow silent videos in CI (not recommended)
# ALLOW_SILENT_VIDEO=true
# Force a specific custom-track index while testing rotation (0-based)
# AUDIO_ROTATION_INDEX=0
# Instagram cover frame offset in ms (default 2500 — after quote fades in)
# IG_COVER_THUMB_OFFSET_MS=2500

# --- YouTube Data API v3 (OAuth 2.0, Desktop app client) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Obtained once via `npm run youtube:auth` (see README.md)
YOUTUBE_REFRESH_TOKEN=

# --- Instagram (Instagram API with Instagram Login) ---
# Long-lived access token for your Instagram professional account,
# with instagram_business_basic + instagram_business_content_publish scopes.
IG_ACCESS_TOKEN=
# The Instagram professional account's numeric user id (graph.instagram.com/me)
IG_USER_ID=

# --- GitHub (local testing only) ---
# Used to host the exported video at a public URL for Instagram.
# Do NOT add these as GitHub Actions secrets — names starting with GITHUB_ are
# reserved. In Actions, the workflow injects github.token + github.repository.
# For local `npm run publish:instagram` only:
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-username/your-repo-name
