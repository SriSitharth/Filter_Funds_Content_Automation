# Copy this file to .env for local testing. In GitHub Actions, these are set as
# Repository Secrets instead (Settings -> Secrets and variables -> Actions).

# --- Content generation (Anthropic) ---
ANTHROPIC_API_KEY=

# --- YouTube Data API v3 (OAuth 2.0, Desktop app client) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Obtained once via `npm run youtube:auth` (see README.md)
YOUTUBE_REFRESH_TOKEN=

# --- Instagram (Instagram API with Instagram Login) ---
# Long-lived access token for your Instagram professional account,
# with instagram_business_basic + instagram_business_content_publish scopes.
IG_ACCESS_TOKEN=
# The Instagram professional account's numeric user id (graph.instagram.com/me)
IG_USER_ID=

# --- GitHub (used to host the exported video at a public URL for Instagram) ---
# In GitHub Actions this is provided automatically as GITHUB_TOKEN; only needed
# in .env for local testing of scripts/publish-instagram.js.
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-org/filter-funds-content
